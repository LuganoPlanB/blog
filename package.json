{
  "name": "@luganoplanb/blog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Plan ₿ Foundation's Hugo publication.",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names images,assets,hugo \"npm:dev:images\" \"npm:dev:assets\" \"npm:dev:hugo\"",
    "dev:images": "node scripts/generate-publication-images.mjs --watch",
    "dev:assets": "vite build --mode development --watch",
    "dev:hugo": "hugo server --baseURL http://localhost:1313/blog/ --appendPort=false --disableFastRender --navigateToChanged",
    "generate:images": "node scripts/generate-publication-images.mjs",
    "build:assets": "npm run generate:images && vite build --mode production",
    "build": "npm run build:assets && hugo --minify --gc --cleanDestinationDir",
    "test:site": "node --test",
    "test": "npm run build && npm run test:site",
    "check": "npm test"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/noto-sans-symbols-2": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "concurrently": "^10.0.5",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0",
    "yaml": "^2.9.1"
  }
}
